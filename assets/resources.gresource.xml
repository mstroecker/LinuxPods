<?xml version="1.0" encoding="UTF-8"?>
<!--
  The prefix is the application's resource base path, derived from its ID.
  GtkApplication adds <prefix>/icons to the icon theme on startup, which is how
  the About dialog finds the app icon without an install.
-->
<gresources>
  <gresource prefix="/io/github/mstroecker/Cymba">
    <file>left_airpod_pro3.png</file>
    <file>right_airpod_pro3.png</file>
    <file>airpod_case.png</file>
    <file alias="icons/scalable/apps/io.github.mstroecker.Cymba.svg">icons/hicolor/scalable/apps/io.github.mstroecker.Cymba.svg</file>
    <file alias="icons/scalable/apps/io.github.mstroecker.Cymba-symbolic.svg">icons/hicolor/symbolic/apps/io.github.mstroecker.Cymba-symbolic.svg</file>
    <file alias="icons/scalable/status/cymba-in-ear-symbolic.svg">icons/cymba-in-ear-symbolic.svg</file>
  </gresource>
</gresources>
